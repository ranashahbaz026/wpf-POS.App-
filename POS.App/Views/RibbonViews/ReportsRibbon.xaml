<UserControl x:Class="POS.App.Views.RibbonViews.ReportsRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.App.Views.RibbonViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal">

        <StackPanel Margin="20">
            <TextBlock Text="Daily Reports" FontWeight="Bold"/>
            <Button Content="Sales Report" Width="140" Margin="0 5 0 0"/>
            <Button Content="Expense Report" Width="140"/>
        </StackPanel>

        <StackPanel Margin="20">
            <TextBlock Text="Monthly Reports" FontWeight="Bold"/>
            <Button Content="Monthly Sales" Width="140" Margin="0 5 0 0"/>
            <Button Content="Monthly Profit" Width="140"/>
        </StackPanel>

    </StackPanel>
</UserControl>
