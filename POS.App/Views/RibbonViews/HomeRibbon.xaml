<UserControl x:Class="POS.App.Views.RibbonViews.HomeRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:POS.App.Views.RibbonViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal">

        <StackPanel Margin="20">
            <TextBlock Text="Registration" FontWeight="Bold"/>
            <Button Content="Add Product" Margin="0 5 0 0" Width="130"/>
            <Button Content="Add User" Width="130" Click="OpenProductsTab"/>
        </StackPanel>

        <StackPanel Margin="20">
            <TextBlock Text="Sales" FontWeight="Bold"/>
            <Button Content="New Sale" Margin="0 5 0 0" Width="130"/>
            <Button Content="Return Sale" Width="130" Click="OpenUsersTab"/>
        </StackPanel>

    </StackPanel>
</UserControl>
