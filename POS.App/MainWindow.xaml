<mah:MetroWindow x:Class="POS.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 Title="POS"
                 MinWidth="1024"
                 MinHeight="768"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Ribbon Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Ribbon Content (button groups) -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- Ribbon Style Tabs -->
        <TabControl x:Name="RibbonTabs" Margin="0,0,0,63" Background="#f3f3f3"
                    BorderThickness="0"
                    Grid.Row="0"
                    SelectionChanged="RibbonTabs_SelectionChanged">
            
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="10,5" />
                </Style>
            </TabControl.Resources>
            
            <!-- Home Tab -->
            <TabItem Header="Home">                
            </TabItem>

            <!-- Reports Tab -->
            <TabItem Header="Reports">                
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <TextBlock Text="Settings go here"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </TabItem>

        </TabControl>

        <ContentControl x:Name="RibbonContent"
                        Grid.Row="1"
                        Margin="10"/>

        <!-- Content area for navigation -->
        <!--<ContentControl x:Name="MainContent" RenderTransformOrigin="0.249,0.222" />-->
        <TabControl x:Name="WorkspaceTabs"
                    Grid.Row="2"
                    Margin="10"
                    mah:TabControlHelper.CloseButtonEnabled="True"
                    />

    </Grid>
</mah:MetroWindow>
