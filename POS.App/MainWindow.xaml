<mah:MetroWindow x:Class="POS.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 Title="MainWindow"
                 Width="800"
                 Height="450"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Ribbon Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Ribbon Content (button groups) -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- Ribbon Style Tabs -->
        <TabControl x:Name="RibbonTabs" Margin="0" Background="#f3f3f3"
                    BorderThickness="0"
                    Grid.Row="0"
                    SelectionChanged="RibbonTabs_SelectionChanged">
            
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="10,5" />
                </Style>
            </TabControl.Resources>
            
            <!-- Home Tab -->
            <TabItem Header="Home">
                <StackPanel Orientation="Horizontal" Margin="20">

                    <!-- Each button group -->
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" Margin="0 0 0 5">Registration</TextBlock>
                        <Button Content="Add Product" Width="120" Margin="0 5 0 0"/>
                        <Button Content="Add User" Width="120"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" Margin="0 0 0 5">Sales</TextBlock>
                        <Button Content="New Sale" Width="120" Margin="0 5 0 0"/>
                        <Button Content="Sale Return" Width="120"/>
                    </StackPanel>

                </StackPanel>
            </TabItem>

            <!-- Reports Tab -->
            <TabItem Header="Reports">
                <StackPanel Orientation="Horizontal" Margin="20">

                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" Margin="0 0 0 5">Daily Reports</TextBlock>
                        <Button Content="Sales Report" Width="130" Margin="0 5 0 0"/>
                        <Button Content="Expense Report" Width="130"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock FontWeight="Bold" Margin="0 0 0 5">Monthly Reports</TextBlock>
                        <Button Content="Monthly Sales" Width="130" Margin="0 5 0 0"/>
                        <Button Content="Monthly Profit" Width="130"/>
                    </StackPanel>

                </StackPanel>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <TextBlock Text="Settings go here"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </TabItem>

        </TabControl>

        <ContentControl x:Name="RibbonContent"
                        Grid.Row="1"
                        Margin="10"/>

        <WrapPanel HorizontalAlignment="Left" Grid.Row="2">
            <Controls:Tile Title="Billing"
                       Margin="10"
                       Background="Teal"
                       HorizontalTitleAlignment="Right">
                <iconPacks:PackIconModern Width="40"
                                      Height="40"
                                      Kind="Billing" />
            </Controls:Tile>
            <Controls:Tile Title="Card"
                       Margin="10"
                       Background="Teal"
                       HorizontalTitleAlignment="Right">
                <iconPacks:PackIconModern Width="40"
                                      Height="40"
                                      Kind="Card1" />
            </Controls:Tile>
            <Controls:Tile Title="User"
                       Margin="50"
                       Background="Teal"
                       HorizontalTitleAlignment="Right">
                <iconPacks:PackIconModern Width="40"
                                      Height="40"
                                      Kind="User" />
            </Controls:Tile>
            <Controls:Tile Title="Cart"
                       Margin="10"
                       Background="Teal"
                       HorizontalTitleAlignment="Right" RenderTransformOrigin="2.341,-0.113">
                <iconPacks:PackIconModern Width="40"
                                      Height="40"
                                      Kind="Cart" />
            </Controls:Tile>
        </WrapPanel>

        <!-- Content area for navigation -->
        <ContentControl x:Name="MainContent" RenderTransformOrigin="0.249,0.222" />

    </Grid>
</mah:MetroWindow>
